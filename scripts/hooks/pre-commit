#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath scripts/hooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
validation="$root/scripts/validation"

bash "$validation/check-meta-logs.sh" --staged
bash "$validation/check-completion-chain-policy.sh"
bash "$validation/check-planning-build-policy.sh"

while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  case "$path" in
    00-project/plans/*)
      ;;
    *)
      continue
      ;;
  esac
  [[ "$path" == *.md ]] || continue

  if ! git diff --quiet -- "$path"; then
    echo "pre-commit: $path is staged but has unstaged edits; stage the full file before commit" >&2
    exit 1
  fi

  if grep -qE '^[[:space:]]*\*\*Tier:\*\*[[:space:]]+T[123][[:space:]]*$' "$root/$path"; then
    bash "$validation/check-plan.sh" "$path"
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)
