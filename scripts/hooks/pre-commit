#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath scripts/hooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
validation="$root/scripts/validation"

bash "$validation/check-meta-logs.sh" --staged
bash "$validation/check-completion-chain-policy.sh"
bash "$validation/check-artifact-lifecycle-policy.sh"
bash "$validation/check-planning-build-policy.sh"

while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  # Active plans get the structural lint. Archived plans also get the state
  # check: nothing is filed as completed with a silently open box.
  state_flag=()
  case "$path" in
    00-project/plans/*)
      ;;
    00-project/plans-completed/*)
      state_flag=(--state)
      ;;
    *)
      continue
      ;;
  esac
  [[ "$path" == *.md ]] || continue

  if ! git diff --quiet -- "$path"; then
    echo "pre-commit: $path is staged but has unstaged edits; stage the full file before commit" >&2
    exit 1
  fi

  if grep -qE '^[[:space:]]*\*\*Tier:\*\*[[:space:]]+T[123][[:space:]]*$' "$root/$path"; then
    bash "$validation/check-plan.sh" ${state_flag[@]+"${state_flag[@]}"} "$path"
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)
